{
  "logging": {
    "log_dir": "data/logging",
    "console_level": "INFO",
    "max_bytes": 10000000,
    "backup_count": 5
  },

  "data": {
    "train_path": "data/raw/claims_train.csv",
    "test_path": "data/raw/claims_test.csv",
    "processed_dir": "data/processed",
    "id_col": "IDpol",
    "target_col": "ClaimRate"
  },

  "reports": {
    "figures_dir": "reports/figures/data"
  },

  "dtypes": {
    "IDpol": "Int64",
    "ClaimNb": "int64",
    "Exposure": "float64",
    "Area": "category",
    "VehPower": "int64",
    "VehAge": "int64",
    "DrivAge": "int64",
    "BonusMalus": "int64",
    "VehBrand": "category",
    "VehGas": "category",
    "Density": "int64",
    "Region": "category"
  },

  "columns": {
    "numeric": [
      "Exposure",
      "VehPower",
      "VehAge",
      "DrivAge",
      "BonusMalus",
      "Density"
    ],
    "categorical": [
      "Area",
      "VehBrand",
      "VehGas",
      "Region"
    ]
  },

  "encoding": {
    "ordinal_cols": [],
    "onehot_cols": [
      "Area",
      "VehBrand",
      "VehGas",
      "Region"
    ],
    "ordinal_orders": {},
    "onehot_drop": null,
    "unknown_ordinal_value": -1
  },

  "pca": {
    "variance_cutoff": 0.90,
    "random_state": 42,
    "figures_dir": "reports/figures/pca"
  },

  "clustering": {
    "k_min": 2,
    "k_max": 8,
    "n_init": 10,
    "random_state": 42,
    "figures_dir": "reports/figures/clustering"
  },

  "evaluation": {
    "metrics": ["rmse", "mae", "r2"],
    "save_plots": true,
    "plots_dir": "reports/figures/models"
  },

  "models": {
    "seed": 42,
    "k_folds": 5,
    "shuffle": true,

    "enabled": [
      "ffnn_numpy",
      "ffnn_torch"
    ],

    "save_best_model": true,
    "artifacts_dir": "artifacts/models",

    "definitions": {
      "ffnn_numpy": {
        "feature_set": "nn",
        "params": {
          "hidden_layers": [256, 128],
          "activations": ["relu", "relu"],
          "output_activation": "linear",
          "loss": "mse",
          "optimizer": {
            "name": "momentum",
            "lr": 0.001,
            "beta": 0.9,
            "weight_decay": 0.0
          },
          "batch_size": 1024,
          "epochs": 20,
          "seed": 42,
          "weight_init": "he",
          "early_stopping": true,
          "patience": 8,
          "min_delta": 1e-5,
          "grad_clip": 5.0
        },
        "param_space": {
          "hidden_layers": [[128, 64], [256, 128]],
          "batch_size": [512, 1024],
          "epochs": [10, 20, 50, 100],
          "optimizer": [
            { "name": "momentum", "lr": 0.001, "beta": 0.9, "weight_decay": 0.0 },
            { "name": "sgd", "lr": 0.005, "weight_decay": 0.0 }
          ]
        },
        "tune_hyperparams": false,
        "n_trials": 5
      },

      "ffnn_torch": {
        "feature_set": "nn",
        "params": {
          "hidden_layers": [256, 128],
          "activations": ["relu", "relu"],
          "dropout": 0.1,
          "output_activation": "linear",
          "loss": "mse",
          "optimizer": {
            "name": "adam",
            "lr": 0.001,
            "weight_decay": 0.0
          },
          "batch_size": 1024,
          "epochs": 20,
          "seed": 42,
          "weight_init": "he",
          "early_stopping": true,
          "patience": 8,
          "min_delta": 1e-5,
          "grad_clip": 5.0,
          "device": "auto"
        },
        "param_space": {
          "hidden_layers": [[256, 128], [512, 256, 128]],
          "dropout": [0.0, 0.1],
          "optimizer": [
            { "name": "adam", "lr": 0.001, "weight_decay": 0.0 },
            { "name": "adam", "lr": 0.0005, "weight_decay": 0.0 }
          ]
        },
        "tune_hyperparams": false,
        "n_trials": 5
      },

      "decision_tree_scratch": {
        "feature_set": "tree",
        "params": {
          "max_depth": 8,
          "min_samples_split": 20,
          "min_samples_leaf": 5,
          "min_impurity_decrease": 0.0001
        },
        "param_space": {
          "max_depth": [4, 6, 8, 12, null],
          "min_samples_split": [10, 20, 50],
          "min_samples_leaf": [1, 5, 10],
          "min_impurity_decrease": [0.0, 0.0001, 0.001]
        },
        "tune_hyperparams": false,
        "n_trials": 20
      },

      "decision_tree_sklearn": {
        "feature_set": "tree",
        "params": {
          "criterion": "squared_error",
          "max_depth": 8,
          "min_samples_split": 20,
          "min_samples_leaf": 5,
          "max_features": null,
          "random_state": 42
        },
        "param_space": {
          "max_depth": [4, 6, 8, 12, null],
          "min_samples_split": [10, 20, 50],
          "min_samples_leaf": [1, 5, 10],
          "max_features": [null, "sqrt", "log2"]
        },
        "tune_hyperparams": false,
        "n_trials": 20
      },

      "random_forest_sklearn": {
        "feature_set": "tree",
        "params": {
          "n_estimators": 200,
          "criterion": "squared_error",
          "max_depth": null,
          "min_samples_split": 20,
          "min_samples_leaf": 5,
          "max_features": "sqrt",
          "bootstrap": true,
          "n_jobs": -1,
          "random_state": 42
        },
        "param_space": {
          "n_estimators": [100, 200, 500],
          "max_depth": [null, 8, 12],
          "min_samples_split": [10, 20, 50],
          "min_samples_leaf": [1, 5, 10],
          "max_features": ["sqrt", "log2"]
        },
        "tune_hyperparams": false,
        "n_trials": 30
      }
    }
  }
}
